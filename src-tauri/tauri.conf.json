{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chroma-desk",
  "version": "0.2.1",
  "identifier": "org.neokuze.chromadesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "chroma-desk",
        "visible": false,
        "minWidth": 360,
        "minHeight": 300,
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/systemd/user/chroma-desk-openrgb.service": "../packaging/chroma-desk-openrgb.service"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/systemd/user/chroma-desk-openrgb.service": "../packaging/chroma-desk-openrgb.service"
        }
      }
    },
    "shortDescription": "Modern UI for OpenRGB",
    "category": "Utility"
  }
}
